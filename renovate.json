{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "recreateWhen": "never",
  "packageRules": [
    {
      "description": "Do not propose the React versions already rejected in PRs #38 and #69.",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "react",
        "react-dom"
      ],
      "allowedVersions": "!/^(19\\.3\\.1)$/"
    },
    {
      "description": "Do not propose the React type versions already rejected in PRs #38 and #69.",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@types/react",
        "@types/react-dom"
      ],
      "allowedVersions": "!/^(19\\.3\\.0)$/"
    },
    {
      "description": "Batch routine dependency updates into one weekly pull request.",
      "matchPackageNames": [
        "*"
      ],
      "groupName": "weekly dependencies",
      "groupSlug": "weekly-dependencies",
      "separateMajorMinor": false,
      "separateMinorPatch": false
    }
  ],
  "baseBranchPatterns": [
    "development"
  ],
  "timezone": "Europe/Madrid",
  "schedule": [
    "* 9-11 * * 1"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "groupName": null,
    "groupSlug": null
  }
}
