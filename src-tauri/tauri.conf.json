{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Valthorne Client",
  "identifier": "com.valthornemc.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Valthorne Client",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "minWidth": 900,
        "minHeight": 650,
        "dragDropEnabled": false,
        "transparent": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "https://crafatar.com", 
          "https://minotar.net",
          "https://mc-heads.net",
          "https://*.minecraft.net", 
          "http://files.playvalthorne.com",
          "https://files.playvalthorne.com",
          "$HOME/.valthorneclient/**/*",
          "$APPDATA/.valthorneclient/**/*",
          "http://localhost:1420/**/*",
          "https://*.mo"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "wix": {
        "language": "es-ES"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/ValthorneMC/ValthorneClient/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "REEMPLAZAR_CON_NUEVA_CLAVE_PUBLICA_MINISIGN"
    }
  }
}
