{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Valthorne Client",
  "identifier": "com.valthornemc.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Valthorne Client",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "minWidth": 900,
        "minHeight": 650,
        "dragDropEnabled": false,
        "transparent": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "https://minotar.net",
          "https://mc-heads.net",
          "https://*.minecraft.net", 
          "http://files.playvalthorne.com",
          "https://files.playvalthorne.com",
          "$HOME/.valthorneclient/**/*",
          "$APPDATA/.valthorneclient/**/*",
          "http://localhost:1420/**/*",
          "https://*.mo"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "deb", "rpm", "appimage"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "entitlements": "entitlements.plist",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "languages": ["English", "Spanish"],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "endpoints": [
        "https://github.com/ValthorneMC/ValthorneClient/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwNkE5NEM3OUU1REMwQUEKUldTcXdGMmV4NVJxSUFobmVnL1pVK283aWhIQS9wNWZzT3hRYmxkcmw0QkZkNnpPRGsrbTRxdzUK"
    }
  }
}
